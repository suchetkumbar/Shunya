# Pinned lab inputs. Changing these changes the lab; record why in design/LAB_CAPABILITIES.md.
ALPINE_URL=https://dl-cdn.alpinelinux.org/alpine/v3.24/releases/cloud/alpine-3.24.2-x86_64-cloudinit-r2.qcow2
ALPINE_SHA512=6b9928cea1c6243affb8a9b09eba6046cd090e8bdb7141fbf0c8f2649c4a99d62e12cda289da41f99de82ce2b3e3780772dd594eaee3693cb49691d81cbe5d4b

# Resource caps (host has 16 GB RAM; WSL capped at 4 GB in .wslconfig).
VM_MEM_MB=1024
VM_CPUS=2
BOOT_SIZE=2G
TARGET_SIZE=1G
USB_SIZE=512M

SSH_PORT=2222

# Default user of the Alpine cloud image (root is locked; we use doas).
VM_USER=alpine

# Packages installed in the lab VM at first boot (lab harness tools only).
# Milestone 7: qpdf, poppler-utils (pdftotext, pdftoppm) and zbar (zbarimg) check the
# certificate PDF and its QR code independently of Shunya's own code.
VM_PACKAGES="util-linux lsblk nvme-cli hdparm sg3_utils e2fsprogs dosfstools exfatprogs testdisk qpdf poppler-utils zbar"
